<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="main" class="container page layout-with-sidebar">
  <section class="content" aria-labelledby="feed-title">
    <h1 id="feed-title" class="sr-only">Latest news</h1>

    <form class="feed-controls" id="feed-controls" role="search" autocomplete="off">
      <div class="search-box">
        <label for="q" class="sr-only">Search articles</label>
        <input type="search" id="q" name="q" placeholder="Search articles…" value="<%= filters.q %>" maxlength="100">
      </div>
      <div class="filter-row">
        <label>
          <span>Category</span>
          <select name="category" id="category">
            <option value="">All categories</option>
            <% categories.forEach(function (c) { %>
              <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option>
            <% }) %>
          </select>
        </label>
        <label>
          <span>Show</span>
          <select name="viewed" id="viewed">
            <option value="all" <%= filters.viewed === 'all' ? 'selected' : '' %>>All articles</option>
            <option value="unviewed" <%= filters.viewed === 'unviewed' ? 'selected' : '' %>>Not viewed yet</option>
            <option value="viewed" <%= filters.viewed === 'viewed' ? 'selected' : '' %>>Already viewed</option>
          </select>
        </label>
        <label>
          <span>Sort by</span>
          <select name="sort" id="sort">
            <option value="date" <%= filters.sort === 'date' ? 'selected' : '' %>>Newest first</option>
            <option value="popular" <%= filters.sort === 'popular' ? 'selected' : '' %>>Most popular</option>
          </select>
        </label>
      </div>
    </form>

    <p class="feed-status muted" id="feed-status" aria-live="polite"><%= feed.total %> articles</p>

    <div class="feed" id="feed">
      <% feed.items.forEach(function (item) { %>
        <%- include('../partials/article-card', { item: item }) %>
      <% }) %>
    </div>
    <p class="empty-state <%= feed.items.length ? 'hidden' : '' %>" id="feed-empty">No articles match your search.</p>

    <div class="feed-loader <%= feed.hasMore ? '' : 'hidden' %>" id="feed-loader" aria-hidden="true">
      <span class="spinner"></span> Loading more articles…
    </div>
    <p class="feed-end muted <%= !feed.hasMore && feed.items.length ? '' : 'hidden' %>" id="feed-end">You have reached the end.</p>
    <div class="center"><button type="button" class="btn btn-ghost hidden" id="feed-retry">Try again</button></div>
  </section>

  <aside class="sidebar" aria-label="Sidebar">
    <%- include('../partials/weather') %>
    <section class="widget">
      <h2>Sections</h2>
      <ul class="category-list">
        <% categories.forEach(function (c) { %>
          <li><a href="/?category=<%= encodeURIComponent(c) %>" data-category="<%= c %>"><%= c %></a></li>
        <% }) %>
      </ul>
    </section>
  </aside>
</main>
<script>
  window.FEED_STATE = <%- JSON.stringify({ page: 1, hasMore: feed.hasMore }) %>;
</script>
<%- include('../partials/footer') %>
<script src="/js/weather.js?v=<%= assetVersion %>"></script>
<script src="/js/home.js?v=<%= assetVersion %>"></script>
</body>
</html>
