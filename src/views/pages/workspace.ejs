<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="main" class="container page">
  <div class="page-head">
    <div>
      <h1><%= currentUser.role === 'editor' ? 'All articles' : 'My articles' %></h1>
      <p class="muted">Your work is saved automatically while you write.</p>
    </div>
    <% if (currentUser.role === 'reporter') { %>
      <button type="button" class="btn" id="new-article">+ New article</button>
    <% } %>
  </div>

  <div class="tabs" id="status-tabs" role="tablist" aria-label="Filter by status">
    <button type="button" class="tab active" data-status="" role="tab" aria-selected="true">All <span class="count" data-count="all"></span></button>
    <% Object.keys(statusLabels).forEach(function (s) { %>
      <button type="button" class="tab" data-status="<%= s %>" role="tab" aria-selected="false"><span class="status-dot status-<%= s %>"></span><%= statusLabels[s] %> <span class="count" data-count="<%= s %>"></span></button>
    <% }) %>
  </div>

  <div class="toolbar">
    <label class="sr-only" for="ws-search">Search by title</label>
    <input type="search" id="ws-search" placeholder="Search by title…" maxlength="100">
  </div>

  <div class="table-wrap">
    <table class="data-table" id="ws-table">
      <thead>
        <tr>
          <th>Title</th>
          <% if (currentUser.role === 'editor') { %><th>Reporter</th><% } %>
          <th>Status</th>
          <th>Last change</th>
          <th class="num">Views</th>
          <th><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody id="ws-rows"></tbody>
    </table>
  </div>
  <p class="empty-state hidden" id="ws-empty">No articles here yet.</p>
  <div class="pager" id="ws-pager"></div>
</main>
<script>window.WS_ROLE = <%- JSON.stringify(currentUser.role) %>;</script>
<%- include('../partials/footer') %>
<script src="/js/workspace.js?v=<%= assetVersion %>"></script>
</body>
</html>
