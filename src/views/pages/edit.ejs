<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="main" class="container page" data-article="<%= articleId %>">
  <div class="page-head">
    <div>
      <p class="breadcrumbs"><a href="/workspace">← Back to articles</a></p>
      <h1>Edit article</h1>
    </div>
    <div class="status-area">
      <span class="status-pill" id="status-pill">Loading…</span>
      <span class="save-state" id="save-state" aria-live="polite"></span>
    </div>
  </div>

  <div class="notice notice-danger hidden" id="editor-note"></div>
  <div class="notice notice-info hidden" id="live-notice"></div>
  <div class="notice notice-warning hidden" id="locked-notice"></div>

  <form class="article-form panel" id="article-form" novalidate>
    <div class="field">
      <label for="title">Title</label>
      <input type="text" id="title" name="title" maxlength="200" required>
      <p class="field-error" data-for="title"></p>
    </div>
    <div class="field">
      <label for="summary">Summary <small class="muted">(shown in the news feed)</small></label>
      <textarea id="summary" name="summary" rows="2" maxlength="500" required></textarea>
      <p class="field-error" data-for="summary"></p>
    </div>
    <div class="form-row">
      <div class="field">
        <label for="category">Category</label>
        <select id="category" name="category" required>
          <option value="">Choose a category…</option>
          <% categories.forEach(function (c) { %><option value="<%= c %>"><%= c %></option><% }) %>
        </select>
        <p class="field-error" data-for="category"></p>
      </div>
      <div class="field grow">
        <label for="imageUrl">Main image</label>
        <div class="image-input">
          <input type="text" id="imageUrl" name="imageUrl" maxlength="500" placeholder="https://… or upload a file">
          <label class="btn btn-ghost btn-small file-btn">Upload<input type="file" id="image-file" accept="image/png,image/jpeg,image/gif,image/webp" hidden></label>
        </div>
        <p class="field-error" data-for="imageUrl"></p>
      </div>
    </div>
    <img class="image-preview hidden" id="image-preview" alt="Selected main image">
    <div class="field">
      <label for="body">Article text <small class="muted">(leave an empty line between paragraphs)</small></label>
      <textarea id="body" name="body" rows="18" maxlength="50000" required></textarea>
      <p class="field-hint"><span id="word-count">0</span> words</p>
      <p class="field-error" data-for="body"></p>
    </div>

    <p class="form-message" id="form-message" role="alert"></p>
    <div class="form-actions">
      <button type="button" class="btn" id="submit-btn">Send for editor approval</button>
      <a class="btn btn-ghost" id="preview-link" href="#" target="_blank" rel="noopener">Preview</a>
      <a class="btn btn-ghost hidden" id="review-link" href="#">Review &amp; approve</a>
      <button type="button" class="btn btn-danger btn-ghost hidden" id="delete-btn">Delete draft</button>
    </div>
  </form>
</main>
<script>window.EDITOR_ROLE = <%- JSON.stringify(currentUser.role) %>;</script>
<%- include('../partials/footer') %>
<script src="/js/edit.js?v=<%= assetVersion %>"></script>
</body>
</html>
